{
  "name": "@ai-novel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "ai:smoke": "tsx src/ai-smoke.ts",
    "ai:turn-smoke": "tsx src/ai-turn-smoke.ts",
    "ai:summary-smoke": "tsx src/summary-smoke.ts",
    "ai:embedding-smoke": "tsx src/embedding-smoke.ts",
    "memory:embed-backfill": "tsx src/memory-embed-backfill.ts",
