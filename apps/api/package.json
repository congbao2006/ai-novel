    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-novel/ai-engine": "workspace:*",
    "@ai-novel/config": "workspace:*",
    "@ai-novel/db": "workspace:*",
    "@ai-novel/domain": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.45.1",
    "fastify": "^5.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
