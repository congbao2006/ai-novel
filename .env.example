# Server-only secrets belong in backend/runtime environments, never in frontend bundles.
NODE_ENV="development"
API_HOST="0.0.0.0"
# Railway provides PORT. API_PORT can override it locally or on other hosts.
API_PORT="4000"
WEB_APP_URL="http://localhost:3000"
API_ALLOWED_ORIGINS="http://localhost:3000"
API_BODY_LIMIT_BYTES="1048576"
API_SLOW_REQUEST_THRESHOLD_MS="1000"
API_SLOW_AI_REQUEST_THRESHOLD_MS="15000"
LOG_LEVEL="info"
NEXT_PUBLIC_API_URL="http://localhost:4000"
DATABASE_URL="postgresql://user:password@localhost:5432/ai_novel"
DATABASE_POOL_MAX="10"
DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
DATABASE_POOL_CONNECTION_TIMEOUT_MS="10000"

AUTH_COOKIE_NAME="ai_novel_session"
AUTH_SESSION_TTL_SECONDS="1209600"
# Use "lax" for same-site custom domains. Use "none" only for cross-site HTTPS web/API hosts.
AUTH_COOKIE_SAME_SITE="lax"

# Server-only AI provider config. Do not commit real keys.
AI_PROVIDER="disabled"
AI_EMBEDDING_PROVIDER="disabled"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"
# 1024 is the conservative MVP default for structured gameplay JSON; lower values can truncate valid proposals.
AI_MAX_OUTPUT_TOKENS="1024"
AI_INTERNAL_SMOKE_ENABLED="false"
# Server-side operational pricing registry. Keep prices current outside source code.
# Example:
# AI_MODEL_PRICING_JSON='{"openai:gpt-5.6":{"inputMicrosPerMillionTokens":0,"outputMicrosPerMillionTokens":0}}'
AI_MODEL_PRICING_JSON="{}"

# Optional integer micros budgets. Empty means disabled.
AI_USER_DAILY_BUDGET_MICROS=""
AI_USER_MONTHLY_BUDGET_MICROS=""
AI_SESSION_BUDGET_MICROS=""

AI_CONTEXT_MAX_RECENT_MESSAGES="20"
AI_CONTEXT_MAX_MEMORIES="20"
AI_CONTEXT_MAX_WORLD_EVENTS="10"
AI_CONTEXT_MAX_SUMMARY_CHARS="6000"
AI_CONTEXT_MAX_MEMORY_CHARS="1000"
AI_SUMMARY_INTERVAL_TURNS="10"
MEMORY_SEMANTIC_SEARCH_ENABLED="false"
MEMORY_SEMANTIC_TOP_K="12"
MEMORY_SEMANTIC_MIN_SCORE="0.72"

# deterministic keeps the local command engine. ai uses AIGateway turn proposals.
GAMEPLAY_ENGINE_MODE="deterministic"
AI_MAX_NPC_REACTIONS_PER_TURN="2"
WORLD_TICK_INTERVAL_TURNS="5"
