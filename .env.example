# Server-only secrets belong in backend/runtime environments, never in frontend bundles.
NODE_ENV="development"
API_HOST="0.0.0.0"
API_PORT="4000"
WEB_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
DATABASE_URL="postgresql://user:password@localhost:5432/ai_novel"

AUTH_COOKIE_NAME="ai_novel_session"
AUTH_SESSION_TTL_SECONDS="1209600"

# Server-only AI provider config. Do not commit real keys.
AI_PROVIDER="disabled"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"
AI_MAX_OUTPUT_TOKENS="256"
AI_INTERNAL_SMOKE_ENABLED="false"
